# Local / compose environment
DB_NAME=entries
DB_USERNAME=entries
DB_PASSWORD=entries
DB_HOST=localhost
DB_PORT=5432

# Backend
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (leave empty in dev so Vite proxies /api to :8080)
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8080

# AWS deployment
AWS_REGION=ap-south-1
CLUSTER=cloudblitz-prod
SERVICE=entries
