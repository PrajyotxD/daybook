# Compose / local stack.
#
#   cp .env.example .env
#
# Only `docker compose` reads this file. Spring Boot does NOT read .env — on the
# EC2 host its settings come from /etc/daybook/daybook.env (installed by
# deploy/ec2/setup.sh), and in dev the defaults in application-dev.yml are used.
#
# Frontend overrides live in frontend/.env — see frontend/.env.example.

DB_NAME=daybook
DB_USERNAME=daybook
DB_PASSWORD=daybook
DB_HOST=localhost
DB_PORT=5432

# Only used when starting the jar by hand (compose maps 8080:8080 itself).
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Container deployment only (the ECS path in infra/).
AWS_REGION=ap-south-1
CLUSTER=cloudblitz-prod
SERVICE=daybook
