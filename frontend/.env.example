# Frontend environment (Vite). Copy to .env only if you need to override.
#
#   cp frontend/.env.example frontend/.env
#
# The defaults below are what development already uses, so this file is optional.

# Where the browser sends API calls. "/api" works both in dev (Vite proxy) and in
# production (Apache proxies /api to the JVM on the same origin).
VITE_API_BASE_URL=/api

# Only used by the dev server proxy — point it elsewhere if the API is not on 8080.
VITE_PROXY_TARGET=http://localhost:8080
