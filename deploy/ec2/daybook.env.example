# Daybook API environment — installed to /etc/daybook/daybook.env (mode 0600)
# The systemd unit reads this file; do not add quotes around values.

SPRING_PROFILES_ACTIVE=prod

# Amazon RDS for PostgreSQL
DB_HOST=daybook-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=daybook
DB_USERNAME=daybook
DB_PASSWORD=change-me

# RDS requires TLS in transit; "prefer" works for a local server without TLS.
DB_SSLMODE=require

# Connection pool — keep small: 1 vCPU instances handle 10 well.
DB_POOL_SIZE=10

# Same-origin via Apache, so CORS is only needed if you call the API from
# another domain. Leave as the public origin.
CORS_ALLOWED_ORIGINS=https://daybook.example.com

# JVM sizing. For a 2 GB instance this leaves room for the OS and page cache.
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
